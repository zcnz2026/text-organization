{
  "name": "text-organization",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "文字整理工具 — 多语种报道剧本自动摘录与排版工具 (Tauri v2 + TypeScript)",
  "scripts": {
    "dev": "node server/main.mjs --dev",
    "start": "npm run build && node server/main.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.6",
    "vitest": "^3.1.4"
  }
}
